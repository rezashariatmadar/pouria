# --- Django backend ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://yadak:yadak@localhost:5432/yadak

# --- URLs ---
# Frontend origin — used for payment callbacks and CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- SMS (OTP + order notifications) ---
SMS_PROVIDER=console            # console | kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=yadak-otp

# --- Payment gateway ---
PAYMENT_PROVIDER=mock           # mock | zibal
ZIBAL_MERCHANT=zibal            # "zibal" = sandbox; real merchant ID in production

# --- Checkout ---
CART_HOLD_MINUTES=15

# --- Media ---
# MEDIA_ROOT=/data/media        # point at the volume mount in production

# --- Next.js frontend (put these in frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1   # browser-side calls
# API_URL=http://localhost:8000/api/v1               # server-side (RSC) calls
